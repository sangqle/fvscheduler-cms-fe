{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Phải trùng tên Worker đã nối Git trên Cloudflare dashboard.
	"name": "fvscheduler-cms-fe",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
	// Không có R2 incremental cache, WORKER_SELF_REFERENCE hay IMAGES: app toàn route động,
	// không ISR/revalidate, không dùng next/image. Thêm lại theo https://opennext.js.org/cloudflare/caching
	// nếu sau này cần.
}
