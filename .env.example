# Copy sang `.env.local` để chạy dev. KHÔNG import file này lên Vercel: giá trị ở
# đây là placeholder, mà biến trên dashboard đè `.env.production` nên sẽ hỏng prod.
# Prod: URL công khai nằm trong `.env.production` đã commit, chỉ NEXTAUTH_SECRET
# đặt trên Vercel dashboard.

# --- Backend ------------------------------------------------------------------
# fvscheduler API, chứa luôn /api/admin/** (prod: https://api-studio.framevis.com)
NEXT_PUBLIC_API_URL=http://localhost:8082

# --- App này ------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3002
# Bắt buộc ở production. Sinh bằng: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret
# Link quay về ERP ở màn 403 (mặc định đã là https://studio.framevis.com)
# NEXT_PUBLIC_ERP_URL=https://studio.framevis.com

# --- Google OAuth -------------------------------------------------------------
# Client id công khai; đổi code lấy token chạy server-side ở backend.
# Redirect URI của app này là <origin>/api/auth/callback/google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
