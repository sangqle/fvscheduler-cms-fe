# Copy to `.env.local` for local development.
# Production values live in the committed `.env.production` (public URLs) plus
# the Vercel dashboard (secrets) — see docs/deployment/vercel.md.

# --- Backends -----------------------------------------------------------------
# ERP API (Spring Boot) — prod https://api-studio.framevis.com
NEXT_PUBLIC_API_URL=http://localhost:8082
# photo-platform backend for signup / check-sign — prod https://api.framevis.com
NEXT_PUBLIC_FRAMEVIS_API_URL=http://localhost:8082

# --- This app -----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3002
# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret
# Absolute-URL fallback for /client-review OG tags when no Host header is readable
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Analytics ----------------------------------------------------------------
# Google Analytics 4 measurement id. Only loaded in production builds.
# Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7CEKDLYW4J

# --- Google OAuth -------------------------------------------------------------
# Public client id; the code exchange happens server-side at the backend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Image / download proxy (client-albums) -----------------------------------
# Prod: https://fpick-cdn.framevis.com / https://fpick-dl.framevis.com
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_PROXY_IMAGE_BASE_URL=http://localhost:8280
NEXT_PUBLIC_PROXY_IMAGE_DOWNLOAD_BASE_URL=http://localhost:8280
# Optional: overrides NEXT_PUBLIC_CDN_URL when resolving relative OG image paths
# NEXT_PUBLIC_IMAGE_BASE_URL=
# Optional: rewrites the CDN host of every client-album image link the backend returns
# (src/lib/cdn.ts). Prod currently pins fpick-cdn2.framevis.com; leave empty to keep
# the backend's own host. Any host set here must be listed in next.config.ts remotePatterns.
# NEXT_PUBLIC_IMAGE_CDN_HOST=
# Optional: comma-separated hosts eligible for that rewrite.
# Default: fpick-cdn.framevis.com,fpick-cdn2.framevis.com
# NEXT_PUBLIC_IMAGE_CDN_SOURCE_HOSTS=
