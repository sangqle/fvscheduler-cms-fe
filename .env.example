# Copy sang `.env.local` khi chạy local.

# ERP API (Spring Boot) · prod https://api-studio.framevis.com
NEXT_PUBLIC_API_URL=http://localhost:8080

NEXTAUTH_URL=http://localhost:3002
# Bắt buộc ở production. Tạo bằng: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret

# Google OAuth: public client id, đổi code ở backend. Redirect URI phải đăng ký:
# http://localhost:3002/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Link "Về ERP" trên màn 403
NEXT_PUBLIC_ERP_URL=http://localhost:3001
