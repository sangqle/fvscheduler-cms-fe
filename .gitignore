# Git worktrees
.worktrees/

# Env files: ignore everything, then allow the two that must be in git.
# .env.production holds only NEXT_PUBLIC_* values, which are inlined into the
# client bundle at build time and are public regardless — Vercel builds from
# this repo, so if it is ignored the deployed app gets no config at all.
# Real secrets (NEXTAUTH_SECRET) live in the Vercel dashboard, never here.
.env*
!.env.example
!.env.production
