# Môi trường production, nạp bởi `next build` khi NODE_ENV=production.
#
# File này được commit có chủ đích: mọi giá trị bên dưới là NEXT_PUBLIC_* hoặc
# OAuth client id, đều bị inline vào bundle client lúc build nên vốn đã công khai.
# Secret không bao giờ nằm ở đây.
#
# Thứ tự ưu tiên (cao thắng), theo Next.js:
#   biến trên Vercel dashboard (process.env) > .env.production.local > .env.local
#   > .env.production > .env
# Vì vậy KHÔNG khai báo các biến dưới đây trên Vercel dashboard: một giá trị rỗng
# hoặc placeholder ở đó sẽ đè file này và làm hỏng prod. Đã dính một lần: import
# nhầm .env.example lên Vercel làm NEXT_PUBLIC_GOOGLE_CLIENT_ID rỗng, Google trả
# "Missing required parameter: client_id".
#
# SECRET đặt trên Vercel dashboard (scope Production + Preview), không để ở đây:
#   NEXTAUTH_SECRET   openssl rand -base64 32

# --- Backend ------------------------------------------------------------------
# fvscheduler API: mọi apiFetch() (src/lib/api/http.ts), toàn bộ /api/admin/**
NEXT_PUBLIC_API_URL=https://api-studio.framevis.com

# --- App này ------------------------------------------------------------------
# Domain prod của CMS. NextAuth v5 đã tin host trên Vercel (VERCEL=1) nên đây chỉ
# là ghim origin cho xác định. Bỏ dòng này nếu muốn preview deploy tự đăng nhập
# trên URL *.vercel.app của chính nó.
NEXTAUTH_URL=https://fravik.framevis.com

# Link quay về ERP ở màn 403 (src/components/admin/shared/ForbiddenScreen.tsx).
NEXT_PUBLIC_ERP_URL=https://studio.framevis.com

# --- Google OAuth -------------------------------------------------------------
# Client id công khai; đổi code lấy token chạy server-side ở backend.
# Redirect URI https://fravik.framevis.com/api/auth/callback/google phải được đăng
# ký trên client này trong Google Cloud Console. Lưu ý path khác ERP: ERP dùng
# /auth/google/callback, CMS dùng /api/auth/callback/google (src/lib/api/auth.ts).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=459897193238-tbss2tbrb2349chltrt77ec7cqb6mt6k.apps.googleusercontent.com
