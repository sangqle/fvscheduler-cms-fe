# Production environment — loaded by `next build` when NODE_ENV=production.
#
# This file IS committed on purpose: every value below is a NEXT_PUBLIC_* URL or
# an OAuth client id, all of which get inlined into the client bundle at build
# time and are therefore public by definition. Secrets never go here.
#
# Precedence (highest wins), per Next.js env loading:
#   Vercel dashboard vars (process.env) > .env.production.local > .env.local
#   > .env.production > .env
# So a local `.env.local` still overrides this file during `npm run build`, and
# anything set in the Vercel dashboard overrides it in CI.
#
# SECRETS — set these in the Vercel dashboard (Production scope), not here:
#   NEXTAUTH_SECRET   openssl rand -base64 32
#
# See docs/deployment/vercel.md for the full runbook.

# --- Backends -----------------------------------------------------------------
# ERP API (Spring Boot) — every apiFetch() call, src/lib/api/http.ts
NEXT_PUBLIC_API_URL=https://api-studio.framevis.com
# photo-platform API — signup / check-sign only, src/lib/config.ts
NEXT_PUBLIC_FRAMEVIS_API_URL=https://api.framevis.com

# --- This app -----------------------------------------------------------------
# Absolute-URL fallback for OG tags on /client-review when no Host header is
# readable (src/app/(public)/client-review/[token]/page.tsx).
NEXT_PUBLIC_APP_URL=https://fravik.framevis.com
# NextAuth v5 already trusts the host on Vercel (VERCEL=1), so this is only a
# pin for a deterministic prod origin. Remove it if preview deployments need to
# authenticate on their own *.vercel.app URL.
NEXTAUTH_URL=https://fravik.framevis.com

# --- Google OAuth -------------------------------------------------------------
# Public client id; the code exchange happens server-side at the backend.
# The redirect URI https://studio.framevis.com/auth/google/callback must be
# registered on this client in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=459897193238-tbss2tbrb2349chltrt77ec7cqb6mt6k.apps.googleusercontent.com

# --- Image / download proxy (client-albums) -----------------------------------
# Preview + download hosts for NAS-backed album photos, src/lib/config.ts.
# fpick-cdn.framevis.com is already allow-listed in next.config.ts remotePatterns.
NEXT_PUBLIC_CDN_URL=https://fpick-cdn.framevis.com
NEXT_PUBLIC_PROXY_IMAGE_BASE_URL=https://fpick-cdn.framevis.com
NEXT_PUBLIC_PROXY_IMAGE_DOWNLOAD_BASE_URL=https://fpick-dl.framevis.com
# Optional: overrides NEXT_PUBLIC_CDN_URL when resolving relative OG image paths.
# NEXT_PUBLIC_IMAGE_BASE_URL=

# Host CDN dùng để render ảnh client album. Backend còn trả link gắn cứng
# fpick-cdn.framevis.com; biến này viết lại host đó lúc chuẩn hoá response
# (src/lib/cdn.ts). Trả về node cũ: đổi lại thành fpick-cdn.framevis.com,
# hoặc bỏ trống để dùng nguyên link backend trả.
NEXT_PUBLIC_IMAGE_CDN_HOST=fpick-cdn2.framevis.com
